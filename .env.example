# ==============================================================================
# Assignment 03: Production-Ready MLOps AI Agent Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# LLM Configuration (Gemini or OpenAI-compatible)
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# MLflow Tracking Server Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=iris-classification-pipeline

# Apache Airflow Configuration (Airflow 3 API Compatible)
AIRFLOW_BASE_URL=http://localhost:8080/api/v2
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TOKEN=

# Kubernetes Configuration
K8S_APPROVED_NAMESPACE=mlops-prod
K8S_CONFIG_PATH=~/.kube/config

# DVC Configuration
DVC_REMOTE_NAME=local_remote
DVC_REMOTE_URL=/tmp/dvc_remote

# Agent Guardrail & Operational Settings
AGENT_ENV=development
AGENT_LOG_LEVEL=INFO

